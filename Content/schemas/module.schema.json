{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SignatureModuleDef",
  "type": "object",
  "required": ["id", "name", "description", "regions", "buildStatus"],
  "additionalProperties": false,
  "properties": {
    "id": {"type": "string", "pattern": "^mod_[a-z0-9_]+$"},
    "name": {"type": "string"},
    "description": {"type": "string"},
    "regions": {"type": "array", "items": {"type": "integer", "minimum": 1}, "minItems": 1},
    "buildStatus": {"type": "string", "enum": ["planned", "in_progress", "done"]}
  }
}
